generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model StarterRecord {
  id                    String   @id @default(cuid())
  owner                 String?
  apn                   String?
  address               String?
  county                String?
  city                  String?
  state                 String?
  zip                   String?
  legalUnit             String?
  legalLotNumber        BigInt?
  legalDistrict         BigInt?
  legalBriefDescription String?

  filed                 Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at")
  pdf                   Json?

  latitude              Float?
  longitude             Float?
  exowners              String[]

  // Indexes for high-performance searching
  @@index([owner])
  @@index([apn])
  @@index([address])
  @@map("starter_records")
}